generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ScanDirection {
  OUT
  IN
}

model ScanEvent {
  id                    Int           @id @default(autoincrement())
  rentmanSerialNumberId String
  direction             ScanDirection
  projectId             String?
  who                   String?
  note                  String?
  createdAt             DateTime      @default(now())

  @@index([rentmanSerialNumberId, createdAt])
}

model LabelTemplate {
  id           Int      @id @default(autoincrement())
  name         String
  widthMm      Float
  heightMm     Float
  elementsJson String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  printJobs PrintJob[]
}

model PrintJob {
  id                    Int      @id @default(autoincrement())
  templateId            Int?
  rentmanSerialNumberId String
  who                   String?
  printedAt             DateTime @default(now())

  // Print history is an audit trail — it should survive a template being
  // redesigned or deleted later, so a deleted template just detaches here
  // rather than blocking the delete or wiping the record of the print.
  template LabelTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
}
