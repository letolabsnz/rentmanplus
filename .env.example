# Read by docker-compose itself (project-root .env, not server/.env or
# pocketbase/.env) to set the app image's build arg — see docker-compose.yml.
# Must be an address the *browser* can reach, not a container-internal one.
# Defaults to http://localhost:8080, which only works if you're browsing
# from the same machine the containers run on.
VITE_POCKETBASE_URL=http://localhost:8080
